    {
      "repository": "gordolio/Trio",
      "number": 1556,
      "title": "Fix stale basal rate on home chart",
      "body": "The rate pill read the newest temp basal's rate whether or not it still ran, so switching to `Basal Testing` Dosing Mode left the cancelled temp on screen. Resolve delivery from pump history, suspensions and the basal profile, against the real clock.\r\n\r\nAlso report the scheduled rate before the pump has any history, flag a manual temp basal, say when delivery is suspended, and draw the profile line on appear.\r\n\r\nFixes #1544",
      "labels": [],
      "url": "https://github.com/nightscout/Trio/pull/1556",
      "mergedAt": "2026-09-21T21:58:11Z"
    },
    {
      "repository": "nightscout/Trio",
      "number": 1556,
      "title": "Fix stale basal rate on home chart",
      "body": "The rate pill read the newest temp basal's rate whether or not it still ran, so switching to `Basal Testing` Dosing Mode left the cancelled temp on screen. Resolve delivery from pump history, suspensions and the basal profile, against the real clock.\r\n\r\nAlso report the scheduled rate before the pump has any history, flag a manual temp basal, say when delivery is suspended, and draw the profile line on appear.\r\n\r\nFixes #1544",
      "labels": [],
      "url": "https://github.com/nightscout/Trio/pull/1556",
      "mergedAt": "2026-09-21T21:58:11Z"
